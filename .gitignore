# User-provided cartridge ROMs and BIOS material (never commit).
roms/
*.gba
*.GBA
*.bin

# Save data and save states.
saves/
*.sav
*.srm
*.fla
*.flash
*.state
*.state[0-9]

# Build output.
build/
build-*/
release-stage/
.bldtmp/
artifacts/
*.exe
*.dll
*.obj
*.pdb
*.ilk
*.tlog

# Generated code is derived from the copyrighted ROM. Regenerate locally.
generated/*.c
generated/*.cpp
generated/*.h
generated/*.json
!generated/README.md

# Runtime caches and local launcher configuration.
recomp_cache/
bios.cfg
rom.cfg
keybinds.ini

# Diagnostic and bring-up artifacts.
_triage/
_*
*.log
*.bmp
*.png
*.rgb
*.csv
*.frag
*.bak
*.local.toml
*.local.ini
recomp_coverage*.json
recomp_master_misses*.toml.frag
recomp_seed_proposals.toml
selfheal*.json
gameplay-selfheal*.json

# IDE, OS, and language caches.
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Capturas seleccionadas para GitHub
!docs/screenshots/*.png

# Android: compilaciones y configuración local
/android/.gradle/
/android/.cxx/
/android/build/
/android/app/.cxx/
/android/app/build/
/android/local.properties
/android/**/local.properties
**/.cxx/
*.apk
*.aab
*.jks
*.keystore
*.pem
*.p12
*.key
**/secrets.properties

# Copias temporales y diagnósticos
*.bak-*
/.backup-*/
/diagnostics/

# Las siete capturas aprobadas
!docs/screenshots/*.png

# Recursos gráficos oficiales del port Android
!android/app/src/main/res/drawable-nodpi/*.png
!android/app/src/main/res/mipmap-nodpi/*.png
